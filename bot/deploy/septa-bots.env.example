# /etc/septa-bots.env — settings for the SEPTA Transit Alerts bots.
# One KEY=value per line, no quotes. After editing:
#   sudo septa-bots check               verify the credentials
#   sudo systemctl restart septa-bots   apply

# ── Posting ──────────────────────────────────────────────────────────────────
# dry-run (default): render every post — text, alt text, map — into
# /var/lib/septa-bots/assets without posting. live: post to Bluesky.
BOT_MODE=dry-run

# The site's public address, used in posts and link cards.
SITE_URL=https://philly-transit-alerts.fyi

# Bluesky accounts: each handle (or login email) and an app password from
# bsky.app → Settings → Privacy and security → App passwords. An account left
# blank simply doesn't post yet.
BLUESKY_ALERTS_IDENTIFIER=alerts.philly-transit-alerts.fyi
BLUESKY_ALERTS_APP_PASSWORD=
BLUESKY_METRO_IDENTIFIER=metro.philly-transit-alerts.fyi
BLUESKY_METRO_APP_PASSWORD=
BLUESKY_BUS_IDENTIFIER=bus.philly-transit-alerts.fyi
BLUESKY_BUS_APP_PASSWORD=
BLUESKY_RAIL_IDENTIFIER=rail.philly-transit-alerts.fyi
BLUESKY_RAIL_APP_PASSWORD=

# ── Maps ─────────────────────────────────────────────────────────────────────
# Mapbox default public token (pk.…) from account.mapbox.com. Without it, maps
# render on a plain background.
MAPBOX_TOKEN=

# ── Publishing the site's data ───────────────────────────────────────────────
# PUBLISH=1 makes this server the site's collector: it pushes the `data`
# branch and triggers deploys, and the GitHub Actions collector stands down.
# BOT_GITHUB_TOKEN: a fine-grained token for this repository only, with
# Contents: read and write, and Actions: read and write.
PUBLISH=0
BOT_GITHUB_TOKEN=
GITHUB_REPO=garlicbuffalo/septa-transit-alerts

# ── Optional ─────────────────────────────────────────────────────────────────
# A healthchecks.io (or similar) ping URL, pinged after every collector tick;
# "/fail" is appended when a tick fails.
HEALTHCHECK_URL=
# Polling: vehicle positions every OBSERVE_INTERVAL_S, collector every
# COLLECT_INTERVAL_S (seconds).
OBSERVE_INTERVAL_S=60
COLLECT_INTERVAL_S=120
# Days of raw vehicle positions to keep.
OBSERVATION_RETENTION_DAYS=3
