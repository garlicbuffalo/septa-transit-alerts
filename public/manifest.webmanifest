{
  "id": "/",
  "name": "SEPTA Transit Alerts",
  "short_name": "SEPTA Alerts",
  "description": "A public archive of SEPTA service alerts and detected disruptions across SEPTA Metro, buses, and Regional Rail, with a 90-day heatmap of incident frequency.",
  "start_url": "/",
  "scope": "/",
